[Unit]
Description=Lumen
After=network-online.target
Wants=network-online.target

[Service]
# Kód v /opt/lumen patří správci serveru (git pull), služba běží pod odděleným uživatelem `lumen`,
# který do kódu jen čte a zapisuje jen do /var/lib/lumen (klíče, limity) a do složky stahování.
User=lumen
Group=lumen
WorkingDirectory=/opt/lumen
EnvironmentFile=/etc/lumen.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
# Služba nemá domovský adresář, yt-dlp a Deno si cache ukládají sem.
Environment=XDG_CACHE_HOME=/var/lib/lumen/cache
ExecStart=/opt/lumen/.venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8000
Restart=always
Nice=10
MemoryMax=2G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lumen /srv/lumen-downloads
# Pojistka: i kdyby se někdo přes Lumen dostal na server, soubory domácího cloudu a datové disky nevidí.
InaccessiblePaths=-/srv/cloud -/opt/cloud -/mnt/disk1 -/mnt/disk2 -/mnt/disk3 -/mnt/disk4

[Install]
WantedBy=multi-user.target
