# Zkopíruj do /etc/lumen.env (sudo cp deploy/lumen.env.example /etc/lumen.env && sudo chmod 600 /etc/lumen.env)
# Heslo AUTH_PASSWORD NEnastavuj: zamklo by celý web i pro lidi s přístupovým klíčem.
DATA_DIR=/var/lib/lumen
DOWNLOAD_DIR=/srv/lumen-downloads/files
KEEP_HOURS=24
MAX_PARALLEL=2
DAILY_LIMIT=5

# Žádosti o klíč z webu (tlačítko "Požádat o klíč"): e-mail o nové žádosti přijde na REQUEST_TO.
# U Gmailu je SMTP_PASSWORD heslo aplikace z https://myaccount.google.com/apppasswords (ne heslo k účtu),
# zapsané BEZ MEZER (16 písmen v jednom kuse), soubor čte i shell.
# Po úpravě: sudo systemctl restart lumen
SMTP_USER=micipapatrmi@gmail.com
SMTP_PASSWORD=
REQUEST_TO=micipapatrmi@gmail.com
# Veřejná adresa Lumenu: odkazy "Schválit" v e-mailu o žádosti vedou na ni (bez lomítka na konci).
PUBLIC_URL=https://lumen.mican.dpdns.org

# Napodobení prohlížeče pro weby, které jinak vrací 403 (nepoužije se na YouTube). Prázdné = vypnuto.
IMPERSONATE=chrome
